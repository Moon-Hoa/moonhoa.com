# Copy to .env.local and fill in once a Supabase project + Cloudflare
# Turnstile site exist. Without these, registration returns a 503 and the
# lot picker falls back to a local demo dataset (see README).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Used by registration, the claim
# endpoint (via /auth/callback), the admin dashboard (Phase 3), and seed-lots.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: omit to fall back to Cloudflare's public "always passes" test
# keys (fine for local dev, not for production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated allowlist of emails permitted to sign into /admin. Simple
# bootstrap model — no DB role column, no chicken-and-egg problem granting
# the first admin. See src/lib/admin.ts.
ADMIN_EMAILS=

# Direct Postgres connection string (Supabase dashboard: "Connect" button ->
# "Direct" tab). Only needed locally, only for scripts/apply-migrations.ts —
# the app itself never uses this, only the REST API (NEXT_PUBLIC_SUPABASE_URL
# + the keys above). Applying migrations by pasting SQL into the dashboard's
# SQL Editor works too, but has no way to verify success from outside the
# browser — this is the reliable alternative.
SUPABASE_DB_URL=

# Optional: only if you want automated Vercel env var / deployment checks
# (see scripts/verify-infra.ts). Vercel dashboard: Account Settings -> Tokens.
VERCEL_TOKEN=
